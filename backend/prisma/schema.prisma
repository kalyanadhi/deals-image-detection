generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL is required when DATABASE_URL uses a connection pooler (e.g. Neon/PgBouncer).
  // Prisma uses DIRECT_URL for migrations; runtime queries use the pooled DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ownedWallets      Wallet[]         @relation("WalletOwner")
  walletMemberships WalletMember[]   @relation("MemberUser")
  invitedMembers    WalletMember[]   @relation("MemberInviter")
  transactions      Transaction[]
  categories        Category[]
  budgets           Budget[]
  goals             Goal[]
  savingsAccounts   SavingsAccount[]
  investments       Investment[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── WALLETS ─────────────────────────────────────────────────────────────────

model Wallet {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String
  description String?
  currency    String   @default("USD") @db.Char(3)
  color       String   @default("indigo")
  icon        String   @default("💳")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner        User           @relation("WalletOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      WalletMember[]
  transactions Transaction[]
  budgets      Budget[]

  @@index([ownerId])
  @@map("wallets")
}

model WalletMember {
  id        String     @id @default(uuid())
  walletId  String     @map("wallet_id")
  userId    String     @map("user_id")
  invitedBy String?    @map("invited_by")
  role      MemberRole @default(viewer)
  createdAt DateTime   @default(now()) @map("created_at")

  wallet  Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user    User   @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter User?  @relation("MemberInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([walletId, userId])
  @@map("wallet_members")
}

enum MemberRole {
  editor
  viewer
}

// ─── CATEGORIES & TRANSACTIONS ───────────────────────────────────────────────

model Category {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  name      String
  type      CategoryType
  icon      String       @default("📌")
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
  @@map("categories")
}

enum CategoryType {
  income
  expense
}

model Transaction {
  id          String          @id @default(uuid())
  walletId    String          @map("wallet_id")
  categoryId  String?         @map("category_id")
  createdBy   String          @map("created_by")
  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  description String?
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  wallet   Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([walletId, date])
  @@map("transactions")
}

enum TransactionType {
  income
  expense
}

// ─── BUDGETS ─────────────────────────────────────────────────────────────────

model Budget {
  id         String       @id @default(uuid())
  walletId   String       @map("wallet_id")
  categoryId String       @map("category_id")
  createdBy  String       @map("created_by")
  amount     Decimal      @db.Decimal(15, 2)
  period     BudgetPeriod @default(monthly)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([walletId, categoryId, period])
  @@map("budgets")
}

enum BudgetPeriod {
  weekly
  monthly
  yearly
}

// ─── GOALS ───────────────────────────────────────────────────────────────────

model Goal {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  name         String
  description  String?
  targetAmount Decimal    @map("target_amount") @db.Decimal(15, 2)
  deadline     DateTime   @db.Date
  icon         String     @default("🎯")
  color        String     @default("indigo")
  status       GoalStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, status])
  @@map("goals")
}

enum GoalStatus {
  active
  completed
  paused
}

model GoalContribution {
  id        String   @id @default(uuid())
  goalId    String   @map("goal_id")
  amount    Decimal  @db.Decimal(15, 2)
  note      String?
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_contributions")
}

// ─── SAVINGS ─────────────────────────────────────────────────────────────────

model SavingsAccount {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  name         String
  interestRate Decimal     @default(0) @map("interest_rate") @db.Decimal(5, 2)
  compounding  Compounding @default(monthly)
  currency     String      @default("USD") @db.Char(3)
  icon         String      @default("🏦")
  color        String      @default("emerald")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions SavingsTransaction[]

  @@index([userId])
  @@map("savings_accounts")
}

enum Compounding {
  monthly
  quarterly
  annually
}

model SavingsTransaction {
  id               String              @id @default(uuid())
  savingsAccountId String              @map("savings_account_id")
  type             SavingsMovementType
  amount           Decimal             @db.Decimal(15, 2)
  note             String?
  date             DateTime            @db.Date
  createdAt        DateTime            @default(now()) @map("created_at")

  account SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)

  @@index([savingsAccountId, date])
  @@map("savings_transactions")
}

enum SavingsMovementType {
  deposit
  withdrawal
}

// ─── INVESTMENTS ─────────────────────────────────────────────────────────────

model Investment {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  name          String
  ticker        String?
  type          InvestmentType
  quantity      Decimal        @db.Decimal(18, 8)
  purchasePrice Decimal        @map("purchase_price") @db.Decimal(15, 2)
  currentPrice  Decimal        @map("current_price") @db.Decimal(15, 2)
  currency      String         @default("USD") @db.Char(3)
  purchaseDate  DateTime       @map("purchase_date") @db.Date
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("investments")
}

enum InvestmentType {
  stock
  crypto
  etf
  mutual_fund
  bond
  real_estate
  other
}
