# ── Database ──────────────────────────────────────────────────────────────────
# For Vercel + Neon:
#   DATABASE_URL  → pooled connection string  (Neon "Pooled connection", port 6543)
#   DIRECT_URL    → direct connection string  (Neon "Direct connection", port 5432)
#                   Prisma uses DIRECT_URL for migrations; queries use DATABASE_URL.
# For a plain PostgreSQL server set both to the same connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/finwallet?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/finwallet"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,https://kalyanadhi.github.io"
